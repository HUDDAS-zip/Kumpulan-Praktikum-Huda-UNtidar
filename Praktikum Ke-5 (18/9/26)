#Buat program yang menampilkan semua bilangan prima antara 1 sampai 100 menggunakan perulangan! 

b = 1

while b <= 100:
    jumlah_pembagi = 0
    
    # Periksa berapa banyak angka yang habis membagi b
    for i in range(1, b + 1):
        if b % i == 0:
            jumlah_pembagi += 1
    if jumlah_pembagi == 2:
        print(f"bilangan prima = {b}")
    else:
        print(f"bilangan non prima = {b}")
    b += 1

print("selesai")
